{
  "name": "Voice Interaction App",
  "short_name": "VoiceApp",
  "description": "Web app for voice interaction with LLM using ElevenLabs and OpenRouter",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "permissions": [
    "microphone",
    "audio-capture"
  ]
}
